print(ggstatsplot::ggbetweenstats(
data = diversity_meta,
x = Habitat,
y = Richness,
type = if (richness_habitat_shapiro$p.value > 0.05) "parametric" else "nonparametric",
pairwise.display = "significant",
title = "MAG richness by habitat",
xlab = NULL, ylab = "MAG richness"
))
richness_habitat_test <- summarise_group_test(richness_habitat_aov, richness_habitat_shapiro, Richness ~ Habitat, diversity_meta)
# Poisson GLM alternative for Richness (a count) - see the helper's
# comment above for why this doesn't apply to Shannon.
richness_habitat_glm <- run_glm_group_test(diversity_meta, "Richness", "Habitat", poisson(link = "log"), "MAG richness by habitat")
# PERMANOVA: does community composition differ by habitat?
# (uses ordination_matrix, i.e. the same samples actually used for NMDS -
# the 2 all-zero samples dropped in section 4 have no metadata row match issue,
# they're just absent from ordination_matrix already)
permanova_metadata <- metadata[match(strip_m_suffix(rownames(ordination_matrix)), metadata$Sample), ]
permanova_habitat <- adonis2(ordination_matrix ~ Habitat, data = permanova_metadata, method = "bray")
print(permanova_habitat)
## ---- 6) Provincia comparison (Navarra folded into Gipuzkoa) --------------
#
# Same NMDS/PCoA/diversity/PERMANOVA as section 5, but grouped by
# Provincia_grouped instead of Habitat. Reuses nmds_meta/pcoa_scores/
# diversity_meta from section 5, which already carry Provincia_grouped
# via the metadata join.
provincia_colors <- c(
"Araba" = "#1b9e77", "Bizkaia" = "#d95f02", "Gipuzkoa" = "#7570b3"
)
# 6a. NMDS colored by provincia, WITH sample labels
ggplot(nmds_meta, aes(x = NMDS1, y = NMDS2, color = Provincia_grouped, label = Sample)) +
geom_point(size = 2.5) +
ggrepel::geom_text_repel(size = 2, max.overlaps = 15, show.legend = FALSE) +
scale_color_manual(values = provincia_colors) +
labs(
title = sprintf("NMDS of MAG community by provincia (stress = %.3f)", nmds$stress),
color = "Provincia"
) +
theme_minimal()
# 6b. Same NMDS colored by provincia, WITHOUT sample labels
ggplot(nmds_meta, aes(x = NMDS1, y = NMDS2, color = Provincia_grouped)) +
geom_point(size = 2.5) +
scale_color_manual(values = provincia_colors) +
labs(
title = sprintf("NMDS of MAG community by provincia (stress = %.3f)", nmds$stress),
color = "Provincia"
) +
theme_minimal()
# 6c-i. PCoA colored by provincia, WITH sample labels
ggplot(pcoa_scores, aes(x = PCoA1, y = PCoA2, color = Provincia_grouped, label = Sample)) +
geom_point(size = 2.5) +
ggrepel::geom_text_repel(size = 2, max.overlaps = 15, show.legend = FALSE) +
scale_color_manual(values = provincia_colors) +
labs(
title = "PCoA of MAG community by provincia (Bray-Curtis)",
x = sprintf("PCoA1 (%.1f%%)", pcoa_var_explained[1]),
y = sprintf("PCoA2 (%.1f%%)", pcoa_var_explained[2]),
color = "Provincia"
) +
theme_minimal()
# 6c-ii. Same PCoA colored by provincia, WITHOUT sample labels
ggplot(pcoa_scores, aes(x = PCoA1, y = PCoA2, color = Provincia_grouped)) +
geom_point(size = 2.5) +
scale_color_manual(values = provincia_colors) +
labs(
title = "PCoA of MAG community by provincia (Bray-Curtis)",
x = sprintf("PCoA1 (%.1f%%)", pcoa_var_explained[1]),
y = sprintf("PCoA2 (%.1f%%)", pcoa_var_explained[2]),
color = "Provincia"
) +
theme_minimal()
# 6d. Diversity by provincia
ggplot(diversity_meta, aes(x = Provincia_grouped, y = Shannon, fill = Provincia_grouped)) +
geom_violin(alpha = 0.5, trim = FALSE) +
geom_boxplot(width = 0.15, fill = "white", outlier.shape = NA) +
geom_jitter(width = 0.05, size = 1.5, alpha = 0.6) +
scale_fill_manual(values = provincia_colors) +
labs(title = "MAG Shannon diversity by provincia") +
theme_minimal()
# 6e. Does the Shannon VALUE itself differ by provincia? Same logic as
# section 5's Habitat block: Shapiro-Wilk on the ANOVA residuals
# decides ANOVA vs. Kruskal-Wallis, then ggstatsplot draws the
# matching plot+test+pairwise-comparisons combination.
provincia_aov <- aov(Shannon ~ Provincia_grouped, data = diversity_meta)
provincia_shapiro <- shapiro.test(residuals(provincia_aov))
cat("\nShapiro-Wilk normality test on ANOVA residuals (Shannon ~ Provincia_grouped):\n")
print(provincia_shapiro)
print(ggstatsplot::ggbetweenstats(
data = diversity_meta,
x = Provincia_grouped,
y = Shannon,
type = if (provincia_shapiro$p.value > 0.05) "parametric" else "nonparametric",
pairwise.display = "significant",
title = "MAG Shannon diversity by provincia",
xlab = NULL, ylab = "Shannon diversity"
))
provincia_group_test <- summarise_group_test(provincia_aov, provincia_shapiro, Shannon ~ Provincia_grouped, diversity_meta)
# Gamma GLM alternative for Shannon.
shannon_provincia_glm <- run_glm_group_test(diversity_meta, "Shannon", "Provincia_grouped", Gamma(link = "log"), "Shannon by provincia")
# Same question as the Habitat block above, but for MAG Richness.
richness_provincia_aov <- aov(Richness ~ Provincia_grouped, data = diversity_meta)
richness_provincia_shapiro <- shapiro.test(residuals(richness_provincia_aov))
cat("\nShapiro-Wilk normality test on ANOVA residuals (Richness ~ Provincia_grouped):\n")
print(richness_provincia_shapiro)
print(ggstatsplot::ggbetweenstats(
data = diversity_meta,
x = Provincia_grouped,
y = Richness,
type = if (richness_provincia_shapiro$p.value > 0.05) "parametric" else "nonparametric",
pairwise.display = "significant",
title = "MAG richness by provincia",
xlab = NULL, ylab = "MAG richness"
))
richness_provincia_test <- summarise_group_test(richness_provincia_aov, richness_provincia_shapiro, Richness ~ Provincia_grouped, diversity_meta)
# Poisson GLM alternative for Richness (a count).
richness_provincia_glm <- run_glm_group_test(diversity_meta, "Richness", "Provincia_grouped", poisson(link = "log"), "MAG richness by provincia")
# 6f. PERMANOVA: does community composition differ by provincia?
permanova_provincia <- adonis2(ordination_matrix ~ Provincia_grouped, data = permanova_metadata, method = "bray")
print(permanova_provincia)
## ---- 7) Combined results table: PERMANOVA vs. Shannon group test ---------
#
# One row per grouping variable (Habitat, Provincia), in English:
# PERMANOVA tests whether MAG COMPOSITION differs between groups
# (Bray-Curtis distances between full community profiles); the
# ANOVA/Kruskal-Wallis test tests whether the single Shannon DIVERSITY
# VALUE differs between groups. They ask different questions and can
# disagree - see the two rows below for an actual example of that in
# this dataset.
results_table <- tibble(
Comparison = c("Habitat", "Provincia"),
PERMANOVA_R2 = c(summarise_permanova(permanova_habitat)$R2, summarise_permanova(permanova_provincia)$R2),
PERMANOVA_F = c(summarise_permanova(permanova_habitat)$F, summarise_permanova(permanova_provincia)$F),
PERMANOVA_p = c(summarise_permanova(permanova_habitat)$p_value, summarise_permanova(permanova_provincia)$p_value),
Shannon_test = c(habitat_group_test$test, provincia_group_test$test),
Shannon_statistic = c(habitat_group_test$statistic, provincia_group_test$statistic),
Shannon_df = c(habitat_group_test$df, provincia_group_test$df),
Shannon_p = c(habitat_group_test$p_value, provincia_group_test$p_value),
Shannon_GLM_family = c(shannon_habitat_glm$family, shannon_provincia_glm$family),
Shannon_GLM_statistic = c(shannon_habitat_glm$statistic, shannon_provincia_glm$statistic),
Shannon_GLM_p = c(shannon_habitat_glm$p_value, shannon_provincia_glm$p_value)
)
cat("\n===== Summary: PERMANOVA (composition) vs. Shannon group test (Kruskal-Wallis/ANOVA vs. Gamma GLM) =====\n")
print(results_table, width = Inf)
# Same idea, for MAG Richness (number of distinct MAGs detected per
# sample) instead of Shannon - no PERMANOVA column here, since
# Richness is a univariate count, not a composition/distance-based
# question.
richness_results_table <- tibble(
Comparison = c("Habitat", "Provincia"),
Richness_test = c(richness_habitat_test$test, richness_provincia_test$test),
Richness_statistic = c(richness_habitat_test$statistic, richness_provincia_test$statistic),
Richness_df = c(richness_habitat_test$df, richness_provincia_test$df),
Richness_p = c(richness_habitat_test$p_value, richness_provincia_test$p_value),
Richness_GLM_family = c(richness_habitat_glm$family, richness_provincia_glm$family),
Richness_GLM_statistic = c(richness_habitat_glm$statistic, richness_provincia_glm$statistic),
Richness_GLM_p = c(richness_habitat_glm$p_value, richness_provincia_glm$p_value)
)
cat("\n===== Summary: MAG richness group test (Kruskal-Wallis/ANOVA vs. Poisson GLM) =====\n")
print(richness_results_table, width = Inf)
######################################
# REPEAT: sections 3-7, excluding samples with Shannon == 0
#
# 3 samples have Shannon == 0 in the analysis above (section 4):
# BPBIL240816M and BPGOR241406M (0 MAGs recovered at all - no bin
# passed MAGScoT/CheckM2 QC for that individual) and BPBIL240817M
# (exactly 1 MAG - Shannon = 0 is the mathematically correct value for
# a single-taxon community, not a data error, but still an extreme,
# uninformative point for this kind of analysis). Everything below
# repeats sections 3-7 on the data with those 3 samples excluded from
# the very start (composition, diversity, ordination, group tests),
# using the same code as above throughout.
######################################
zero_shannon_samples <- diversity_df$Sample[diversity_df$Shannon == 0]
cat(sprintf(
"\nExcluding %d sample(s) with Shannon == 0 from the repeated analysis below: %s\n",
length(zero_shannon_samples), paste(zero_shannon_samples, collapse = ", ")
))
coverm_long_nz <- coverm_long |> filter(!Sample %in% zero_shannon_samples)
unmapped_nz <- coverm_long_nz |> filter(Genome == "unmapped")
mag_long_nz <- coverm_long_nz |> filter(Genome != "unmapped")
mag_matrix_nz <- mag_long_nz |>
pivot_wider(names_from = Sample, values_from = RelAbundance) |>
column_to_rownames("Genome") |>
as.matrix()
## ---- 8) Community composition (no zero-Shannon samples) ------------------
mean_unmapped_nz <- mean(unmapped_nz$RelAbundance, na.rm = TRUE)
cat(sprintf("Mean unmapped fraction across samples (Shannon == 0 excluded): %.1f%%\n", mean_unmapped_nz))
ggplot(unmapped_nz, aes(x = reorder(Sample, RelAbundance), y = RelAbundance)) +
geom_col(fill = "grey60") +
coord_flip() +
labs(
title = "Unmapped read percentage per sample (Shannon == 0 excluded)",
x = NULL, y = "Unmapped (%)"
) +
theme_minimal(base_size = 8)
top_mags_nz <- mag_long_nz |>
group_by(Genome) |>
summarise(mean_abund = mean(RelAbundance)) |>
slice_max(mean_abund, n = 15) |>
pull(Genome)
mag_long_grouped_nz <- mag_long_nz |>
mutate(Genome_grp = if_else(Genome %in% top_mags_nz, Genome, "Other"))
ggplot(mag_long_grouped_nz, aes(x = Sample, y = RelAbundance, fill = Genome_grp)) +
geom_col() +
labs(
title = "MAG relative abundance per sample (top 15 + Other, Shannon == 0 excluded)",
x = NULL, y = "Relative abundance (%)", fill = "MAG"
) +
theme_minimal(base_size = 8) +
theme(axis.text.x = element_text(angle = 90, hjust = 1, vjust = 0.5, size = 5))
pheatmap(
log1p(mag_matrix_nz),
show_rownames = TRUE,
show_colnames = TRUE,
fontsize_row = 6,
fontsize_col = 5,
main = "MAG relative abundance (log1p-scaled, Shannon == 0 excluded)"
)
prevalence_nz <- mag_long_nz |>
group_by(Genome) |>
summarise(
n_samples_present = sum(RelAbundance > 0),
pct_samples_present = 100 * n_samples_present / n_distinct(mag_long_nz$Sample),
mean_abund_when_present = mean(RelAbundance[RelAbundance > 0])
) |>
arrange(desc(n_samples_present))
print(prevalence_nz)
## ---- 9) Diversity and ordination (no zero-Shannon samples) ---------------
sample_matrix_nz <- t(mag_matrix_nz)
sample_matrix_nz[is.na(sample_matrix_nz)] <- 0
diversity_df_nz <- tibble(
Sample = rownames(sample_matrix_nz),
Shannon = diversity(sample_matrix_nz, index = "shannon"),
Simpson = diversity(sample_matrix_nz, index = "simpson"),
Richness = rowSums(sample_matrix_nz > 0)
)
ggplot(diversity_df_nz, aes(x = reorder(Sample, Shannon), y = Shannon)) +
geom_col(fill = "steelblue") +
coord_flip() +
labs(title = "Shannon diversity of MAG community per sample (Shannon == 0 excluded)", x = NULL) +
theme_minimal(base_size = 8)
# No further all-zero-abundance samples are possible here - both
# samples that triggered this check in section 4 (BPBIL240816M,
# BPGOR241406M) are already excluded above - kept for consistency with
# section 4's logic in case that ever changes.
zero_samples_nz <- rownames(sample_matrix_nz)[rowSums(sample_matrix_nz) == 0]
if (length(zero_samples_nz) > 0) {
cat(sprintf(
"Dropping %d sample(s) with 0%% reads mapped to any MAG (excluded from NMDS): %s\n",
length(zero_samples_nz), paste(zero_samples_nz, collapse = ", ")
))
}
ordination_matrix_nz <- sample_matrix_nz[rowSums(sample_matrix_nz) > 0, , drop = FALSE]
set.seed(1)
nmds_nz <- metaMDS(ordination_matrix_nz, distance = "bray", trymax = 100)
nmds_scores_nz <- as_tibble(scores(nmds_nz, display = "sites"), rownames = "Sample")
ggplot(nmds_scores_nz, aes(x = NMDS1, y = NMDS2, label = Sample)) +
geom_point(size = 2) +
ggrepel::geom_text_repel(size = 2, max.overlaps = 15) +
labs(title = sprintf("NMDS of MAG community (stress = %.3f, Shannon == 0 excluded)", nmds_nz$stress)) +
theme_minimal()
## ---- 10) Metadata integration by Habitat (no zero-Shannon samples) -------
nmds_meta_nz <- nmds_scores_nz |>
mutate(Metadata_key = strip_m_suffix(Sample)) |>
left_join(metadata, by = c("Metadata_key" = "Sample")) |>
dplyr::select(-Metadata_key)
# 10a. NMDS colored by habitat, WITH sample labels
ggplot(nmds_meta_nz, aes(x = NMDS1, y = NMDS2, color = Habitat, label = Sample)) +
geom_point(size = 2.5) +
ggrepel::geom_text_repel(size = 2, max.overlaps = 15, show.legend = FALSE) +
scale_color_manual(values = habitat_colors) +
labs(
title = sprintf("NMDS of MAG community by habitat (stress = %.3f, Shannon == 0 excluded)", nmds_nz$stress),
color = "Habitat"
) +
theme_minimal()
# 10b. Same NMDS colored by habitat, WITHOUT sample labels
ggplot(nmds_meta_nz, aes(x = NMDS1, y = NMDS2, color = Habitat)) +
geom_point(size = 2.5) +
scale_color_manual(values = habitat_colors) +
labs(
title = sprintf("NMDS of MAG community by habitat (stress = %.3f, Shannon == 0 excluded)", nmds_nz$stress),
color = "Habitat"
) +
theme_minimal()
# 10c. PCoA (Bray-Curtis), no-zero-Shannon version of section 5c
bray_dist_nz <- vegdist(ordination_matrix_nz, method = "bray")
pcoa_nz <- cmdscale(bray_dist_nz, k = 2, eig = TRUE)
pcoa_var_explained_nz <- round(100 * pcoa_nz$eig[1:2] / sum(pcoa_nz$eig[pcoa_nz$eig > 0]), 1)
pcoa_scores_nz <- as_tibble(pcoa_nz$points, rownames = "Sample") |>
rename(PCoA1 = V1, PCoA2 = V2) |>
mutate(Metadata_key = strip_m_suffix(Sample)) |>
left_join(metadata, by = c("Metadata_key" = "Sample")) |>
dplyr::select(-Metadata_key)
# 10c-i. PCoA colored by habitat, WITH sample labels
ggplot(pcoa_scores_nz, aes(x = PCoA1, y = PCoA2, color = Habitat, label = Sample)) +
geom_point(size = 2.5) +
ggrepel::geom_text_repel(size = 2, max.overlaps = 15, show.legend = FALSE) +
scale_color_manual(values = habitat_colors) +
labs(
title = "PCoA of MAG community by habitat (Bray-Curtis, Shannon == 0 excluded)",
x = sprintf("PCoA1 (%.1f%%)", pcoa_var_explained_nz[1]),
y = sprintf("PCoA2 (%.1f%%)", pcoa_var_explained_nz[2]),
color = "Habitat"
) +
theme_minimal()
# 10c-ii. Same PCoA colored by habitat, WITHOUT sample labels
ggplot(pcoa_scores_nz, aes(x = PCoA1, y = PCoA2, color = Habitat)) +
geom_point(size = 2.5) +
scale_color_manual(values = habitat_colors) +
labs(
title = "PCoA of MAG community by habitat (Bray-Curtis, Shannon == 0 excluded)",
x = sprintf("PCoA1 (%.1f%%)", pcoa_var_explained_nz[1]),
y = sprintf("PCoA2 (%.1f%%)", pcoa_var_explained_nz[2]),
color = "Habitat"
) +
theme_minimal()
# Diversity by habitat (no zero-Shannon samples)
diversity_meta_nz <- diversity_df_nz |>
mutate(Metadata_key = strip_m_suffix(Sample)) |>
left_join(metadata, by = c("Metadata_key" = "Sample")) |>
dplyr::select(-Metadata_key)
ggplot(diversity_meta_nz, aes(x = Habitat, y = Shannon, fill = Habitat)) +
geom_violin(alpha = 0.5, trim = FALSE) +
geom_boxplot(width = 0.15, fill = "white", outlier.shape = NA) +
geom_jitter(width = 0.05, size = 1.5, alpha = 0.6) +
scale_fill_manual(values = habitat_colors) +
labs(title = "MAG Shannon diversity by habitat (Shannon == 0 excluded)") +
theme_minimal()
habitat_aov_nz <- aov(Shannon ~ Habitat, data = diversity_meta_nz)
habitat_shapiro_nz <- shapiro.test(residuals(habitat_aov_nz))
cat("\n[Shannon == 0 excluded] Shapiro-Wilk normality test on ANOVA residuals (Shannon ~ Habitat):\n")
print(habitat_shapiro_nz)
print(ggstatsplot::ggbetweenstats(
data = diversity_meta_nz,
x = Habitat,
y = Shannon,
type = if (habitat_shapiro_nz$p.value > 0.05) "parametric" else "nonparametric",
pairwise.display = "significant",
title = "MAG Shannon diversity by habitat (Shannon == 0 excluded)",
xlab = NULL, ylab = "Shannon diversity"
))
habitat_group_test_nz <- summarise_group_test(habitat_aov_nz, habitat_shapiro_nz, Shannon ~ Habitat, diversity_meta_nz)
# PERMANOVA: does community composition differ by habitat? (no
# zero-Shannon samples)
permanova_metadata_nz <- metadata[match(strip_m_suffix(rownames(ordination_matrix_nz)), metadata$Sample), ]
permanova_habitat_nz <- adonis2(ordination_matrix_nz ~ Habitat, data = permanova_metadata_nz, method = "bray")
print(permanova_habitat_nz)
## ---- 11) Metadata integration by Provincia (no zero-Shannon samples) -----
#
# Same NMDS/PCoA/diversity/PERMANOVA as section 10, but grouped by
# Provincia_grouped instead of Habitat. Reuses nmds_meta_nz/
# pcoa_scores_nz/diversity_meta_nz from section 10.
# 11a. NMDS colored by provincia, WITH sample labels
ggplot(nmds_meta_nz, aes(x = NMDS1, y = NMDS2, color = Provincia_grouped, label = Sample)) +
geom_point(size = 2.5) +
ggrepel::geom_text_repel(size = 2, max.overlaps = 15, show.legend = FALSE) +
scale_color_manual(values = provincia_colors) +
labs(
title = sprintf("NMDS of MAG community by provincia (stress = %.3f, Shannon == 0 excluded)", nmds_nz$stress),
color = "Provincia"
) +
theme_minimal()
# 11b. Same NMDS colored by provincia, WITHOUT sample labels
ggplot(nmds_meta_nz, aes(x = NMDS1, y = NMDS2, color = Provincia_grouped)) +
geom_point(size = 2.5) +
scale_color_manual(values = provincia_colors) +
labs(
title = sprintf("NMDS of MAG community by provincia (stress = %.3f, Shannon == 0 excluded)", nmds_nz$stress),
color = "Provincia"
) +
theme_minimal()
# 11c-i. PCoA colored by provincia, WITH sample labels
ggplot(pcoa_scores_nz, aes(x = PCoA1, y = PCoA2, color = Provincia_grouped, label = Sample)) +
geom_point(size = 2.5) +
ggrepel::geom_text_repel(size = 2, max.overlaps = 15, show.legend = FALSE) +
scale_color_manual(values = provincia_colors) +
labs(
title = "PCoA of MAG community by provincia (Bray-Curtis, Shannon == 0 excluded)",
x = sprintf("PCoA1 (%.1f%%)", pcoa_var_explained_nz[1]),
y = sprintf("PCoA2 (%.1f%%)", pcoa_var_explained_nz[2]),
color = "Provincia"
) +
theme_minimal()
# 11c-ii. Same PCoA colored by provincia, WITHOUT sample labels
ggplot(pcoa_scores_nz, aes(x = PCoA1, y = PCoA2, color = Provincia_grouped)) +
geom_point(size = 2.5) +
scale_color_manual(values = provincia_colors) +
labs(
title = "PCoA of MAG community by provincia (Bray-Curtis, Shannon == 0 excluded)",
x = sprintf("PCoA1 (%.1f%%)", pcoa_var_explained_nz[1]),
y = sprintf("PCoA2 (%.1f%%)", pcoa_var_explained_nz[2]),
color = "Provincia"
) +
theme_minimal()
# 11d. Diversity by provincia
ggplot(diversity_meta_nz, aes(x = Provincia_grouped, y = Shannon, fill = Provincia_grouped)) +
geom_violin(alpha = 0.5, trim = FALSE) +
geom_boxplot(width = 0.15, fill = "white", outlier.shape = NA) +
geom_jitter(width = 0.05, size = 1.5, alpha = 0.6) +
scale_fill_manual(values = provincia_colors) +
labs(title = "MAG Shannon diversity by provincia (Shannon == 0 excluded)") +
theme_minimal()
provincia_aov_nz <- aov(Shannon ~ Provincia_grouped, data = diversity_meta_nz)
provincia_shapiro_nz <- shapiro.test(residuals(provincia_aov_nz))
cat("\n[Shannon == 0 excluded] Shapiro-Wilk normality test on ANOVA residuals (Shannon ~ Provincia_grouped):\n")
print(provincia_shapiro_nz)
print(ggstatsplot::ggbetweenstats(
data = diversity_meta_nz,
x = Provincia_grouped,
y = Shannon,
type = if (provincia_shapiro_nz$p.value > 0.05) "parametric" else "nonparametric",
pairwise.display = "significant",
title = "MAG Shannon diversity by provincia (Shannon == 0 excluded)",
xlab = NULL, ylab = "Shannon diversity"
))
provincia_group_test_nz <- summarise_group_test(provincia_aov_nz, provincia_shapiro_nz, Shannon ~ Provincia_grouped, diversity_meta_nz)
# 11e. PERMANOVA: does community composition differ by provincia? (no
# zero-Shannon samples)
permanova_provincia_nz <- adonis2(ordination_matrix_nz ~ Provincia_grouped, data = permanova_metadata_nz, method = "bray")
print(permanova_provincia_nz)
## ---- 12) Combined results table (no zero-Shannon samples) ----------------
results_table_nz <- tibble(
Comparison = c("Habitat", "Provincia"),
PERMANOVA_R2 = c(summarise_permanova(permanova_habitat_nz)$R2, summarise_permanova(permanova_provincia_nz)$R2),
PERMANOVA_F = c(summarise_permanova(permanova_habitat_nz)$F, summarise_permanova(permanova_provincia_nz)$F),
PERMANOVA_p = c(summarise_permanova(permanova_habitat_nz)$p_value, summarise_permanova(permanova_provincia_nz)$p_value),
Shannon_test = c(habitat_group_test_nz$test, provincia_group_test_nz$test),
Shannon_statistic = c(habitat_group_test_nz$statistic, provincia_group_test_nz$statistic),
Shannon_df = c(habitat_group_test_nz$df, provincia_group_test_nz$df),
Shannon_p = c(habitat_group_test_nz$p_value, provincia_group_test_nz$p_value)
)
cat("\n===== Summary (Shannon == 0 excluded): PERMANOVA (composition) vs. Shannon group test (diversity value) =====\n")
print(results_table_nz, width = Inf)
######################################
# ---- 13) Robustness check: sequencing depth confound on MAG richness by
# Provincia ----------------------------------------------------------------
#
# MAG richness (section 6/7) showed the strongest effect in the whole
# script (Kruskal-Wallis p ~ 1e-07 for Provincia). But richness counts
# are mechanically sensitive to how much was sequenced - a sample with
# more (bacterial) reads has more chances to detect a low-abundance
# MAG, independent of any real ecological difference. This section
# checks whether that raw richness result actually reflects uneven
# sequencing depth across provinces, using Kraken2/Bracken's per-sample
# classified read count (visualize_bracken.R's data source) as a depth
# proxy, and a Poisson GLM with an offset to control for it - the
# standard way to adjust a count model for sampling effort.
# Depth proxy: total Bracken-classified reads per sample at species
# level (sum of Reads_clade across all species assigned to that
# sample). Not the same as raw sequencing depth (that would need the
# fastp/host-depletion reports, not available in this repo checkout),
# but a reasonable stand-in for how much bacterial signal was
# available to detect MAGs from in each sample.
bracken_for_depth <- read_tsv("visualize/combined_bracken_family_genus_species.tsv", show_col_types = FALSE)
depth_proxy <- bracken_for_depth |>
filter(Rank == "S") |>
group_by(Sample) |>
summarise(Total_classified_reads = sum(Reads_clade, na.rm = TRUE))
depth_meta <- diversity_meta |>
mutate(Metadata_key = strip_m_suffix(Sample)) |>
left_join(
depth_proxy |> mutate(Metadata_key = strip_m_suffix(Sample)) |> dplyr::select(-Sample),
by = "Metadata_key"
) |>
dplyr::select(-Metadata_key)
cat(sprintf(
"\nDepth proxy available for %d / %d samples used in the Richness ~ Provincia comparison.\n",
sum(!is.na(depth_meta$Total_classified_reads)), nrow(depth_meta)
))
# 13a. Does sequencing depth itself differ by Provincia?
depth_aov <- aov(Total_classified_reads ~ Provincia_grouped, data = depth_meta)
depth_shapiro <- shapiro.test(residuals(depth_aov))
cat("\nShapiro-Wilk normality test on ANOVA residuals (depth proxy ~ Provincia):\n")
print(depth_shapiro)
print(ggstatsplot::ggbetweenstats(
data = depth_meta,
x = Provincia_grouped,
y = Total_classified_reads,
type = if (depth_shapiro$p.value > 0.05) "parametric" else "nonparametric",
pairwise.display = "significant",
title = "Sequencing depth proxy by provincia",
xlab = NULL, ylab = "Total classified reads (Bracken, species level)"
))
depth_provincia_test <- summarise_group_test(depth_aov, depth_shapiro, Total_classified_reads ~ Provincia_grouped, depth_meta)
cat(sprintf(
"\nDepth ~ Provincia: %s, statistic = %.2f, df = %s, p = %.4f\n",
depth_provincia_test$test, depth_provincia_test$statistic, depth_provincia_test$df, depth_provincia_test$p_value
))
# 13b. Does depth correlate with MAG richness?
cat("\nSpearman correlation: MAG richness ~ depth proxy\n")
print(cor.test(depth_meta$Richness, depth_meta$Total_classified_reads, method = "spearman"))
cat("\nPearson correlation: MAG richness ~ depth proxy\n")
print(cor.test(depth_meta$Richness, depth_meta$Total_classified_reads, method = "pearson"))
# 13c. Does the Provincia effect on richness survive controlling for
# depth? offset(log(depth)) fixes the coefficient on log(depth) to
# exactly 1 rather than estimating it, which is the standard way to
# model a rate (richness per unit of sequencing effort) instead of a
# raw count - the right correction here, rather than just adding
# log(depth) as an ordinary covariate.
richness_offset_model <- glm(
Richness ~ Provincia_grouped + offset(log(Total_classified_reads)),
data = depth_meta, family = poisson(link = "log")
)
cat("\nPoisson GLM: Richness ~ Provincia_grouped + offset(log(depth))\n")
print(summary(richness_offset_model))
richness_offset_null <- glm(
Richness ~ offset(log(Total_classified_reads)),
data = depth_meta, family = poisson(link = "log")
)
cat("\nLikelihood-ratio test: Provincia effect on richness AFTER controlling for depth\n")
print(anova(richness_offset_null, richness_offset_model, test = "Chisq"))
